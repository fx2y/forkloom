{
  "name": "forkloom-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "biome check src scripts tests apps/api apps/web/src apps/web/test packages",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:contracts": "tsx packages/contracts/src/check.ts",
    "typegen:contracts": "tsx packages/contracts/src/typegen.ts --write",
    "dev:api": "tsx apps/api/src/server.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@biomejs/biome": "^1.9.4",
    "@dbos-inc/dbos-sdk": "^4.9.11",
    "@dbos-inc/kysely-datasource": "^4.9.11",
    "@mariozechner/pi-coding-agent": "^0.55.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.16.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^5.1.0",
    "jsdom": "^26.1.0",
    "kysely": "^0.28.11",
    "multer": "^2.0.2",
    "pg": "^8.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
