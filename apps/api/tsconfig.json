{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@forkloom/contracts": ["../../packages/contracts/src/index"],
			"@forkloom/shared": ["../../packages/shared/src/index"]
		}
	},
	"include": ["src/**/*.ts"],
	"references": [
		{ "path": "../../packages/contracts" },
		{ "path": "../../packages/shared" }
	]
}
