{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkloom.local/schema/pi-session-event.schema.json",
  "title": "PiSessionEvent",
  "type": "object",
  "required": ["id", "type", "message"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["prompt", "follow_up", "tool_call", "tool_result", "assistant", "system"]
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "additionalProperties": true,
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "system", "tool"]
        },
        "content": {
          "type": "string"
        },
        "streamingBehavior": {
          "type": "string",
          "enum": ["steer", "followUp"]
        }
      }
    }
  }
}
