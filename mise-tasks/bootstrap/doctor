#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds mise jq
optional_cmds_status fnox docker curl sqlite3 | tee .cache/doctor.optional.txt >/dev/null

if find . \
  \( -path './.git' -o -path './node_modules' \) -prune -o \
  -type f -name '.env*' -print | rg -q '.'; then
  echo ".env* files are forbidden; use fnox only" >&2
  exit 1
fi

mise env >/dev/null

if [[ "${PI_RPC_STRICT_REAL:-0}" == "1" ]]; then
  for pi_state in "${HOME}/.pi/agent/auth.json" "${HOME}/.pi/agent/settings.json"; do
    if [[ ! -f "$pi_state" ]]; then
      echo "strict-real PI requires host state file: $pi_state" >&2
      exit 1
    fi
  done
fi

if command -v docker >/dev/null 2>&1; then
  docker compose ps >/dev/null || true
fi

write_mark "bootstrap:doctor"
echo "bootstrap:doctor ok"
