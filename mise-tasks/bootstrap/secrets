#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds mise rg

if ! rg -q '^\[providers\.age\]' fnox.toml; then
  echo "fnox age provider missing in fnox.toml" >&2
  exit 1
fi

if command -v fnox >/dev/null 2>&1; then
  fnox exec -- true
  fnox provider test age >/dev/null
else
  echo "fnox not found; install via mise" >&2
  exit 1
fi

for required_var in \
  DBOS_SYSTEM_DATABASE_URL \
  S3_ENDPOINT \
  S3_ACCESS_KEY \
  S3_SECRET_KEY \
  PI_PROVIDER \
  PI_MODEL \
  ZAI_ENDPOINT \
  ZAI_KEY \
  DOC_OCR_MODEL \
  DOC_PARSER_VERSION \
  DOC_NORM_VERSION \
  DOC_LIMIT_PDF_BYTES \
  DOC_LIMIT_PDF_PAGES \
  DOC_LIMIT_IMAGE_BYTES \
  DOC_OCR_QUEUE_CONCURRENCY \
  DOC_OCR_QUEUE_RATE_LIMIT_PER_SECOND; do
  if [[ -z "${!required_var:-}" ]]; then
    echo "missing required secret/env: $required_var" >&2
    exit 1
  fi
done

mise env --redacted >/tmp/mise.env.redacted
write_mark "bootstrap:secrets"
echo "bootstrap:secrets ok"
