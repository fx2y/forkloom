#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds rg ast-grep

mkdir -p .cache/spec07
mkdir -p .cache/spec08
mkdir -p .cache/spec09
rg -n "No generalized observability|No extra event bus|No provenance DB" \
  spec-0/06-spec.md README.md docs/adr > .cache/spec07/scope-guard.c4-not-now.txt

for needle in "No generalized observability" "No extra event bus" "No provenance DB"; do
  if ! rg -q "$needle" .cache/spec07/scope-guard.c4-not-now.txt; then
    echo "scope guard missing: $needle" >&2
    exit 1
  fi
done

rg -n "provenance\\+retrieval|skip entity graph|entities/facts/graph" \
  spec-0/07-spec.md README.md docs/adr > .cache/spec07/scope-guard.c5-scope.txt || true
for needle in "provenance+retrieval" "skip entity graph"; do
  if ! rg -Fq "$needle" .cache/spec07/scope-guard.c5-scope.txt; then
    echo "scope guard missing spec07 C5 scope lock: $needle" >&2
    exit 1
  fi
done

rg -n "doc ingest|GLM-OCR|nasty docs|kill.*resume|spec-0/07" \
  README.md docs/adr docs/runbook mise-tasks/check/scope-guard \
  > .cache/spec07/scope-guard.doc-ops.txt || true
for needle in "doc ingest" "GLM-OCR" "nasty docs" "kill" "spec-0/07"; do
  if ! rg -Fq "$needle" .cache/spec07/scope-guard.doc-ops.txt; then
    echo "scope guard missing C5 operator flow proof phrase: $needle" >&2
    exit 1
  fi
done

rg -n "RunDocSearch|RunDocResolve|SpanRef" \
  contracts/v1 packages/contracts/src/check.ts apps/api/src/run/public-surface.ts \
  > .cache/spec07/scope-guard.doc-wire.txt
for needle in "RunDocSearch" "RunDocResolve" "SpanRef"; do
  if ! rg -q "$needle" .cache/spec07/scope-guard.doc-wire.txt; then
    echo "scope guard missing run-owned doc noun: $needle" >&2
    exit 1
  fi
done

if rg -n "app\\.(get|post|put|patch|delete)\\(\"/docs|router\\.(get|post|put|patch|delete)\\(\"/docs" \
  apps/api/src/http > .cache/spec07/scope-guard.docs-route-violations.txt; then
  echo "top-level /docs route is forbidden; keep doc wire under /runs" >&2
  exit 1
fi

rg -n "SandboxSpec|SandboxState|SandboxEvent|SandboxCommand|RunDocSearch|RunDocResolve|SpanRef" \
  contracts/v1 packages/contracts/src/check.ts apps/api/src/run/public-surface.ts \
  > .cache/spec07/scope-guard.noun-scan.txt

ast-grep --lang typescript -p "RUN_PUBLIC_BANNED_SANDBOX_NOUNS" \
  apps/api/src/run/public-surface.ts > .cache/spec07/scope-guard.ast-grep.txt
if [[ ! -s .cache/spec07/scope-guard.ast-grep.txt ]]; then
  echo "scope guard ast-grep found no banned-sandbox constant anchor" >&2
  exit 1
fi

rg -n "/runs/:runId/skills|/runs/:runId/skills/preview|RUN_SKILL_CLIENT_ROUTE_TEMPLATES|RUN_SKILL_CLIENT_COMMAND_ALIAS|parseRunSkillPreviewPayload" \
  apps/api/src/http/run-routes.ts apps/api/src/run/public-surface.ts apps/web/src/run-client.ts \
  > .cache/spec08/scope-guard.skill-wire.txt
for needle in "/runs/:runId/skills" "/runs/:runId/skills/preview" "RUN_SKILL_CLIENT_COMMAND_ALIAS"; do
  if ! rg -Fq "$needle" .cache/spec08/scope-guard.skill-wire.txt; then
    echo "scope guard missing run-owned skill wire anchor: $needle" >&2
    exit 1
  fi
done

if rg -n "app\\.(get|post|put|patch|delete)\\(\"/skills|router\\.(get|post|put|patch|delete)\\(\"/skills" \
  apps/api/src/http > .cache/spec08/scope-guard.skills-route-violations.txt; then
  echo "top-level /skills route is forbidden; keep skill wire under /runs" >&2
  exit 1
fi

ast-grep --lang typescript -p '{ kind: "skill" }' \
  apps/api/src/http apps/api/src/run apps/web/src \
  > .cache/spec08/scope-guard.skill-kind.ast.txt || true
if [[ -s .cache/spec08/scope-guard.skill-kind.ast.txt ]]; then
  echo "public command kind=skill is forbidden" >&2
  exit 1
fi

if rg -n "innerHTML" apps/web/src > .cache/spec08/scope-guard.innerhtml.scan.txt; then
  echo "innerHTML usage is forbidden in web surface" >&2
  exit 1
fi

rg -n "RUN_EXTENSION_UI_ALIASES|RUN_C7_TOP_LEVEL_ROUTE_BANS|/extensions|/packages|/themes|/reload" \
  apps/api/src/run/public-surface.ts mise-tasks/check/scope-guard \
  > .cache/spec09/scope-guard.ext-wire.txt
for needle in "RUN_EXTENSION_UI_ALIASES" "RUN_C7_TOP_LEVEL_ROUTE_BANS" "/extensions" "/packages" "/themes" "/reload"; do
  if ! rg -Fq "$needle" .cache/spec09/scope-guard.ext-wire.txt; then
    echo "scope guard missing C7 wire freeze anchor: $needle" >&2
    exit 1
  fi
done

if rg -n "app\\.(get|post|put|patch|delete)\\(\"/(extensions|packages|themes|reload)|router\\.(get|post|put|patch|delete)\\(\"/(extensions|packages|themes|reload)" \
  apps/api/src/http > .cache/spec09/scope-guard.ext-route-violations.txt; then
  echo "top-level /extensions|/packages|/themes|/reload routes are forbidden; keep wire run-owned" >&2
  exit 1
fi

rg -n "registerProvider|providerRegistry|buildProviderOverrideRegistry|resolveProviderOverride" \
  apps/api/src/pi/extensions/service.ts apps/api/src/pi/providers apps/api/src/pi/session-factory.ts \
  > .cache/spec09/scope-guard.provider-seam.txt
for needle in "registerProvider" "buildProviderOverrideRegistry" "resolveProviderOverride"; do
  if ! rg -Fq "$needle" .cache/spec09/scope-guard.provider-seam.txt; then
    echo "scope guard missing provider override seam anchor: $needle" >&2
    exit 1
  fi
done

rg -n "extensions/(will-run|artifact-widget|structured-wizard)/index.ts" \
  spec-0/09-05-htn.sqlite > .cache/spec09/scope-guard.flagship-scope.txt || true
for path in "extensions/will-run/index.ts" "extensions/artifact-widget/index.ts" "extensions/structured-wizard/index.ts"; do
  if [[ ! -f "$path" ]]; then
    echo "scope guard missing flagship extension file: $path" >&2
    exit 1
  fi
done

ast-grep --lang typescript -p "RUN_C7_TOP_LEVEL_ROUTE_BANS" \
  apps/api/src/run/public-surface.ts > .cache/spec09/scope-guard.ext-ban.ast.txt
if [[ ! -s .cache/spec09/scope-guard.ext-ban.ast.txt ]]; then
  echo "scope guard ast-grep found no C7 top-level route ban anchor" >&2
  exit 1
fi

if rg -n "innerHTML" apps/web/src > .cache/spec09/scope-guard.c7-innerhtml.scan.txt; then
  echo "innerHTML usage is forbidden in C7 web surface" >&2
  exit 1
fi

rg -n "class PiRpcClient|class RpcPiSessionPort|class SandboxRpcSessionPort" \
  apps/api/src/pi/rpc-client.ts apps/api/src/pi/session-port.ts apps/api/src/sandbox/pi-session-factory.ts \
  > .cache/spec09/cy7-rpc-seam.ast.txt
for needle in "PiRpcClient" "RpcPiSessionPort" "SandboxRpcSessionPort"; do
  if ! rg -Fq "$needle" .cache/spec09/cy7-rpc-seam.ast.txt; then
    echo "scope guard missing rpc seam class anchor: $needle" >&2
    exit 1
  fi
done

rg -n "name: policy-qa|name: contract-review|name: invoice-extract|name: meeting-to-actions|## Outputs \\(ARTIFACTS\\)|scripts/emit-.*\\.sh" \
  skills/*/SKILL.md > .cache/spec08/scope-guard.pack.scan.txt
for needle in "name: policy-qa" "name: contract-review" "name: invoice-extract" "name: meeting-to-actions" "## Outputs (ARTIFACTS)"; do
  if ! rg -Fq "$needle" .cache/spec08/scope-guard.pack.scan.txt; then
    echo "scope guard missing first-party pack footprint anchor: $needle" >&2
    exit 1
  fi
done

write_mark "check:scope-guard"
echo "check:scope-guard ok"
