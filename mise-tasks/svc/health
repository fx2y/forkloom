#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds docker curl rg

docker compose ps postgres seaweedfs pi api web >/tmp/svc.ps

# Postgres uses a different check mechanism
for _ in $(seq 1 60); do
  if docker compose exec -T postgres pg_isready -U postgres -d agentos >/tmp/svc.pg 2>/dev/null; then
    break
  fi
  sleep 1
done

if ! docker compose exec -T postgres pg_isready -U postgres -d agentos >/tmp/svc.pg 2>/dev/null; then
  echo "postgres healthcheck failed" >&2
  exit 1
fi

wait_for_url "seaweed" "http://localhost:8333" "/tmp/svc.s3" "-sS" || exit 1
wait_for_url "api" "http://localhost:8080/health" "/tmp/svc.api" "-fsS" || exit 1
wait_for_url "web" "http://localhost:5173" "/tmp/svc.web" "-fsS" || exit 1

# PI runs as stdio RPC process (no HTTP health endpoint); treat running container as ready.
docker compose ps pi --format json > /tmp/svc.pi.ps
if ! rg -q '"State":"running"' /tmp/svc.pi.ps; then
  echo "pi container is not running" >&2
  exit 1
fi
echo '{"ok":true,"mode":"stdio-rpc"}' > /tmp/svc.pi

# Extra safety: ensure API reports OK
if ! grep -q '"ok":true' /tmp/svc.api; then
  echo "api healthcheck reported NOT ok: $(cat /tmp/svc.api)" >&2
  exit 1
fi

write_mark "svc:health"
echo "svc:health ok"
