#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds pnpm

mkdir -p .cache/test-int
pnpm exec tsx scripts/harness/run-sandbox-files.ts
pnpm exec vitest run tests/int/run-sandbox-files.test.ts

write_mark "test:int:run-sandbox-files"
echo "test:int:run-sandbox-files ok"
