#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds curl jq python3 pnpm

mkdir -p .cache/test-int
INPUT=.cache/test-int/artifact.input
cp fixtures/sessions/sample.session.jsonl "$INPUT"

curl -fsS -F "file=@$INPUT" "http://localhost:8080/artifacts" > .cache/test-int/artifact.meta.1.json
curl -fsS -F "file=@$INPUT" "http://localhost:8080/artifacts" > .cache/test-int/artifact.meta.2.json

HASH1=$(jq -r '.sha256' .cache/test-int/artifact.meta.1.json)
HASH2=$(jq -r '.sha256' .cache/test-int/artifact.meta.2.json)
if [[ "$HASH1" != "$HASH2" || -z "$HASH1" ]]; then
  echo "artifact dedupe/hash contract failed" >&2
  exit 1
fi

curl -fsS "http://localhost:8080/artifacts/$HASH1" > .cache/test-int/artifact.download.bin
FETCH_HASH=$(python3 - <<'PY'
import hashlib
with open(".cache/test-int/artifact.download.bin","rb") as f:
    print(hashlib.sha256(f.read()).hexdigest())
PY
)
if [[ "$FETCH_HASH" != "$HASH1" ]]; then
  echo "fetched artifact bytes hash mismatch" >&2
  exit 1
fi

curl -fsS "http://localhost:8080/artifacts/$HASH1/meta" > .cache/test-int/artifact.meta.get.json
META_HASH=$(jq -r '.sha256' .cache/test-int/artifact.meta.get.json)
if [[ "$META_HASH" != "$HASH1" ]]; then
  echo "meta endpoint sha mismatch" >&2
  exit 1
fi

PARENT_SHA=$(printf 'b%.0s' {1..64})
curl -fsS -X POST "http://localhost:8080/artifacts/$HASH1/link" \
  -H "content-type: application/json" \
  -d "{\"parent\":\"$PARENT_SHA\",\"meta\":{\"ingest.note\":\"linked\"}}" > .cache/test-int/artifact.meta.link.json

if [[ "$(jq -r '.meta["ingest.note"]' .cache/test-int/artifact.meta.link.json)" != "linked" ]]; then
  echo "link endpoint did not patch metadata" >&2
  exit 1
fi

HTTP_CODE=$(curl -sS -o /tmp/artifact.sha.err -w "%{http_code}" \
  -H "content-type: application/octet-stream" \
  -H "x-sha256: $(printf 'c%.0s' {1..64})" \
  --data-binary @"$INPUT" \
  "http://localhost:8080/artifacts")
if [[ "$HTTP_CODE" != "400" ]]; then
  echo "expected sha mismatch rejection, got status $HTTP_CODE" >&2
  cat /tmp/artifact.sha.err >&2 || true
  exit 1
fi

write_mark "test:int:artifact"
echo "test:int:artifact ok"
