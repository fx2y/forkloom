#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds pnpm docker

mkdir -p .cache/test-int
docker compose restart api >/dev/null
wait_for_url "api" "http://127.0.0.1:8080/health" /tmp/svc.api
pnpm exec tsx scripts/harness/run-sse-live.ts
pnpm exec vitest run tests/int/run-sse-live.test.ts

write_mark "test:int:run-sse"
echo "test:int:run-sse ok"
