#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/common.sh"

cd_repo_root
require_cmds mise rg pnpm ast-grep

mkdir -p .cache/spec07
rg -n "IngestDocV1|registerIngestDocWorkflow|executeIngestDoc" \
  apps/api/src/workflow apps/api/src/server.ts apps/api/src/http/run-doc-routes.ts \
  > .cache/spec07/cy5-register.scan.txt
rg -n "WorkflowQueue|doc_ocr_q|rateLimitPerSecond|workerConcurrency" \
  apps/api/src \
  > .cache/spec07/cy5-queue.scan.txt
rg -n "ocr_done|norm_done|indexed|done|failed|parse status" \
  apps/api/src/doc apps/api/src/workflow/doc-*.ts \
  > .cache/spec07/cy5-status.scan.txt

rg -n "OCR_DONE|layout_parsing|getParsePayload|return cached" \
  apps/api/src/doc apps/api/src/workflow/doc-*.ts \
  > .cache/spec07/cy6-ocr-step.scan.txt
rg -n "ocr_usage|usage|md.raw|parse/|putJSON|putArtifact" \
  apps/api/src/doc apps/api/src/workflow/doc-*.ts \
  > .cache/spec07/cy6-ocr-persist.scan.txt
rg -n "doc-ocr|single-bill|usage once|limit|doc-workflow|doc-zai-client|doc-status" \
  tests/unit mise-tasks/test/int \
  > .cache/spec07/cy6-ocr-proof.txt

ast-grep --lang ts --pattern 'fetch($$$)' apps/api/src \
  > .cache/spec07/cy6-fetch.ast.txt || true

MISE_EXPERIMENTAL=1 mise exec -- pnpm exec vitest run \
  tests/unit/doc-status.test.ts \
  tests/unit/doc-zai-client.test.ts \
  tests/unit/doc-workflow.test.ts

MISE_EXPERIMENTAL=1 mise exec -- pnpm exec tsx \
  scripts/harness/doc-live-e2e.ts \
  .cache/spec07/cy6-live-e2e.json

MISE_EXPERIMENTAL=1 mise exec -- pnpm exec vitest run \
  tests/int/doc-live-e2e.test.ts

{
  printf 'cy5_gate=ok\n'
  date -u +"ts=%Y-%m-%dT%H:%M:%SZ"
} > .cache/spec07/cy5-gate.txt

{
  printf 'cy6_gate=ok\n'
  printf 'cy6_live_e2e=.cache/spec07/cy6-live-e2e.json\n'
  date -u +"ts=%Y-%m-%dT%H:%M:%SZ"
} > .cache/spec07/cy6-gate.txt

write_mark "test:int:doc-ocr"
echo "test:int:doc-ocr ok"
