{
  "$id": "https://forkloom/contracts/v1/RunSpec.schema.json",
  "title": "RunSpec",
  "type": "object",
  "required": [
    "runId",
    "scope",
    "userMsg",
    "attachments",
    "orgId",
    "writeTarget"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "scope": {
      "type": "string",
      "enum": ["me", "team", "org"]
    },
    "userMsg": {
      "type": "string",
      "minLength": 1
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "orgId": {
      "type": "string",
      "minLength": 1
    },
    "wsId": {
      "type": "string",
      "minLength": 1
    },
    "memberId": {
      "type": "string",
      "minLength": 1
    },
    "writeTarget": {
      "type": "string",
      "enum": ["org", "ws", "member"]
    },
    "workdirRef": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "modelPref": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": ["safe", "std", "priv"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "writeTarget": {
            "const": "org"
          }
        }
      },
      "then": {
        "properties": {
          "wsId": false,
          "memberId": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "writeTarget": {
            "const": "ws"
          }
        }
      },
      "then": {
        "required": ["wsId"],
        "properties": {
          "memberId": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "writeTarget": {
            "const": "member"
          }
        }
      },
      "then": {
        "required": ["wsId", "memberId"]
      }
    }
  ],
  "additionalProperties": false
}
