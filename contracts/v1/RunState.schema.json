{
  "$id": "https://forkloom/contracts/v1/RunState.schema.json",
  "title": "RunState",
  "type": "object",
  "required": ["runId", "status", "startedAt", "dbosWfId", "artifacts"],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "awaiting_approval", "running", "done", "failed", "aborted"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dbosWfId": {
      "type": "string",
      "minLength": 1
    },
    "piSessionId": {
      "type": "string",
      "minLength": 1
    },
    "piSessionFile": {
      "type": "string",
      "pattern": "^(s3://|https?://).+"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "imageDigest",
        "profile",
        "network",
        "workdir",
        "timeoutSec",
        "maxBytesOut",
        "mounts"
      ],
      "properties": {
        "imageDigest": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": ["safe", "std", "priv"]
        },
        "network": {
          "type": "string",
          "enum": ["off", "egress"]
        },
        "workdir": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytesOut": {
          "type": "integer",
          "minimum": 1
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dest", "mode", "kind"],
            "properties": {
              "dest": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "type": "string",
                "enum": ["rw", "ro"]
              },
              "kind": {
                "type": "string",
                "enum": ["work", "inputs", "cache"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["required", "state"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": ["not_required", "pending", "approved"]
        }
      },
      "additionalProperties": false
    },
    "currentCommand": {
      "type": "object",
      "required": ["seq", "kind", "state"],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": ["approve", "prompt", "followUp", "steer", "abort"]
        },
        "state": {
          "type": "string",
          "enum": ["queued", "claimed", "done", "dead"]
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "workspaceRef": {
          "type": "object",
          "required": ["sha256"],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
